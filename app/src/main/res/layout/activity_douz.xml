<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:src="@drawable/douz"
            android:scaleType="centerCrop"
            android:contentDescription="Sahara de Douz" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sahara de Douz"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:gravity="center"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gouvernorat : Kébili"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Douz est surnommée la porte du Sahara. Elle est célèbre pour ses dunes de sable, ses paysages désertiques et ses traditions sahariennes. C'est une destination idéale pour découvrir le désert tunisien."
            android:textSize="16sp"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurants 🍽️"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurant Le Saharien"
            android:tag="Restaurant Le Saharien, Douz Tunisia"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="17sp"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurant El Faouar"
            android:tag="Restaurant El Faouar, Douz Tunisia"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="17sp"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hôtels 🏨"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The Residence Douz"
            android:tag="The Residence Douz Tunisia"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="17sp"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hotel Sahara Douz"
            android:tag="Hotel Sahara Douz Tunisia"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="17sp"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cafés ☕"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Café du Désert"
            android:tag="Cafe du Desert, Douz Tunisia"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="17sp"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
