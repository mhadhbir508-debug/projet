<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:src="@drawable/kerkennah"
            android:scaleType="centerCrop"
            android:contentDescription="Îles Kerkennah" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Îles Kerkennah"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gouvernorat : Sfax"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Les îles Kerkennah sont un archipel situé au large de Sfax. Elles sont réputées pour leurs plages tranquilles, leurs eaux peu profondes, leurs traditions de pêche et leurs paysages naturels. Les visiteurs peuvent découvrir la vie insulaire, déguster des spécialités de poissons et profiter du calme de la Méditerranée."
            android:textSize="16sp"
            android:textColor="#444444"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurants à proximité 🍽️"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:layout_marginTop="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Restaurants à Kerkennah"
            android:tag="Restaurants à Kerkennah"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="16sp"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hôtels à proximité 🏨"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:layout_marginTop="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Hôtels à Kerkennah"
            android:tag="Hôtels à Kerkennah"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="16sp"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cafés à proximité ☕"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:layout_marginTop="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Cafés à Kerkennah"
            android:tag="Cafés à Kerkennah"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="16sp"
            android:padding="10dp" />

    </LinearLayout>
</ScrollView>
