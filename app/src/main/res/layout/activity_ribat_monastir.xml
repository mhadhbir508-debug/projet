<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:src="@drawable/ribat_monastir"
            android:scaleType="centerCrop"
            android:contentDescription="Ribat de Monastir" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ribat de Monastir"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gouvernorat : Monastir"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Le Ribat de Monastir est un monument historique construit au VIIIe siècle. Il servait autrefois de forteresse défensive et de lieu de surveillance du littoral. Aujourd'hui, il attire les visiteurs grâce à son architecture islamique, ses tours et son importance historique dans le patrimoine tunisien."
            android:textSize="16sp"
            android:textColor="#444444"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurants à proximité 🍽️"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:layout_marginTop="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Restaurants à Monastir"
            android:tag="Restaurants à Monastir"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="16sp"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hôtels à proximité 🏨"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:layout_marginTop="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Hôtels à Monastir"
            android:tag="Hôtels à Monastir"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="16sp"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cafés à proximité ☕"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:layout_marginTop="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Cafés à Monastir"
            android:tag="Cafés à Monastir"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="16sp"
            android:padding="10dp" />

    </LinearLayout>
</ScrollView>
