<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:src="@drawable/carthage"
            android:scaleType="centerCrop"
            android:contentDescription="Carthage" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carthage 🇹🇳"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:gravity="center"
            android:padding="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gouvernorat : Tunis"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carthage est une ancienne cité historique de Tunisie. Elle est célèbre pour son patrimoine punique et romain, ses sites archéologiques et les thermes d'Antonin."
            android:textSize="16sp"
            android:textColor="#333333"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurants à proximité 🍽️"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Le Golfe"
            android:tag="Le Golfe, Carthage Tunis"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="17sp"
            android:padding="15dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Villa Didon Restaurant"
            android:tag="Villa Didon Restaurant, Carthage Tunis"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="17sp"
            android:padding="15dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hôtels 🏨"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Villa Didon"
            android:tag="Villa Didon, Carthage Tunis"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="17sp"
            android:padding="15dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cafés ☕"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#123B5D"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Café de Carthage"
            android:tag="Cafe de Carthage, Tunis"
            android:onClick="ouvrirLieu"
            android:clickable="true"
            android:textSize="17sp"
            android:padding="15dp"
            android:background="#FFFFFF" />

    </LinearLayout>
</ScrollView>
